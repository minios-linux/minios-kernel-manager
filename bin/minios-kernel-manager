#!/bin/sh
#
# MiniOS Kernel Manager GUI Launcher
# This script launches the kernel manager GUI application
#

set -e

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: minios-kernel-manager

Launch the MiniOS Kernel Manager graphical interface.

This command opens the GTK application for listing kernels, activating a
kernel for the next boot, and packaging kernels from repository packages or
local .deb files.

For the command-line interface, run: minios-kernel --help
For the manual page, run: man minios-kernel-manager
EOF
        exit 0
        ;;
esac

# Find the real directory of the script
SCRIPT_DIR=$(dirname "$(readlink -f -- "$0")")

# Always prefer local source version over installed version
DIR="$(dirname "$SCRIPT_DIR")/lib"
if [ -f "$DIR/minios_kernel_manager.py" ]; then
    # Use local source version
    exec python3 -u "$DIR/minios_kernel_manager.py" "$@"
elif [ -f "/usr/lib/minios-kernel-manager/minios_kernel_manager.py" ]; then
    # Fallback to installed version
    exec python3 -u "/usr/lib/minios-kernel-manager/minios_kernel_manager.py" "$@"
else
    echo "Error: Could not find minios_kernel_manager.py" >&2
    exit 1
fi
