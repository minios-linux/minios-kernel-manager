#. type: Plain text
#: en/minios-kernel.1:4
msgid "minios-kernel - Command-line tool for managing MiniOS kernels"
msgstr ""
"minios-kernel - Kommandozeilenwerkzeug zur Verwaltung von MiniOS-Kernels"

#. type: Plain text
#: en/minios-kernel.1:7
msgid "B<minios-kernel> [I<--help>]"
msgstr "B<minios-kernel> [I<--help>]"

#. type: Plain text
#: en/minios-kernel.1:11
msgid "B<minios-kernel> [B<--json>] B<list>"
msgstr "B<minios-kernel> [B<--json>] B<list>"

#. type: Plain text
#: en/minios-kernel.1:16
msgid "B<minios-kernel> [B<--json>] B<activate> I<kernel-version>"
msgstr "B<minios-kernel> [B<--json>] B<activate> I<kernel-version>"

#. type: Plain text
#: en/minios-kernel.1:21
msgid "B<minios-kernel> [B<--json>] B<info> [I<kernel-version>]"
msgstr "B<minios-kernel> [B<--json>] B<info> [I<kernel-version>]"

#. type: Plain text
#: en/minios-kernel.1:32
msgid ""
"B<minios-kernel> [B<--json>] B<package> {B<--repo> I<package> |B<--deb> "
"I<file...>} B<-o> I<output-dir> [I<options>]"
msgstr ""
"B<minios-kernel> [B<--json>] B<package> {B<--repo> I<package> |B<--deb> "
"I<file...>} B<-o> I<output-dir> [I<options>]"

#. type: Plain text
#: en/minios-kernel.1:36
msgid "B<minios-kernel> [B<--json>] B<status>"
msgstr "B<minios-kernel> [B<--json>] B<status>"

#. type: Plain text
#: en/minios-kernel.1:41
msgid "B<minios-kernel> [B<--json>] B<delete> I<kernel-version>"
msgstr "B<minios-kernel> [B<--json>] B<delete> I<kernel-version>"

#. type: Plain text
#: en/minios-kernel.1:44
msgid ""
"B<minios-kernel> is a command-line utility for managing Linux kernels in the "
"MiniOS distribution. Requires root privileges."
msgstr ""
"B<minios-kernel> ist ein Kommandozeilenwerkzeug zur Verwaltung von Linux-"
"Kernels in der MiniOS-Distribution. Erfordert Root-Rechte."

#. type: Plain text
#: en/minios-kernel.1:48
msgid ""
"This tool serves as both a standalone CLI utility and the backend for the "
"graphical B<minios-kernel-manager>.  It handles kernel packaging, "
"activation, and provides detailed kernel information."
msgstr ""
"Dieses Werkzeug dient sowohl als eigenständiges CLI-Programm als auch als "
"Backend für die grafische B<minios-kernel-manager>.  Es übernimmt das "
"Verpacken und Aktivieren von Kernels und stellt detaillierte Kernel-"
"Informationen bereit."

#. type: Plain text
#: en/minios-kernel.1:52
msgid "Show the built-in help message and exit."
msgstr "Zeigt die integrierte Hilfemeldung an und beendet das Programm."

#. type: TP
#: en/minios-kernel.1:52
#, no-wrap
msgid "B<--json>"
msgstr "B<--json>"

#. type: Plain text
#: en/minios-kernel.1:55
msgid "Output results in JSON format. Can be used with any command."
msgstr ""
"Gibt die Ergebnisse im JSON-Format aus. Kann mit jedem Befehl verwendet "
"werden."

#. type: SH
#: en/minios-kernel.1:55
#, no-wrap
msgid "COMMANDS"
msgstr "BEFEHLE"

#. type: TP
#: en/minios-kernel.1:56 en/minios-kernel.1:178
#, no-wrap
msgid "B<list>"
msgstr "B<list>"

#. type: Plain text
#: en/minios-kernel.1:59
msgid "List available kernels with their status."
msgstr "Listet verfügbare Kernel mit ihrem Status auf."

#. type: TP
#: en/minios-kernel.1:59
#, no-wrap
msgid "B<activate>I< kernel-version>"
msgstr "B<activate>I< kernel-version>"

#. type: Plain text
#: en/minios-kernel.1:62
msgid "Activate the specified kernel version for the next boot."
msgstr "Aktiviert die angegebene Kernel-Version für den nächsten Systemstart."

#. type: TP
#: en/minios-kernel.1:62
#, no-wrap
msgid "B<info>I< [kernel-version]>"
msgstr "B<info>I< [kernel-version]>"

#. type: Plain text
#: en/minios-kernel.1:65
msgid ""
"Show information about a kernel. If no version specified, shows current "
"active kernel."
msgstr ""
"Zeigt Informationen zu einem Kernel an. Ohne Angabe einer Version wird der "
"aktuell aktive Kernel angezeigt."

#. type: TP
#: en/minios-kernel.1:65 en/minios-kernel.1:187
#, no-wrap
msgid "B<package>"
msgstr "B<package>"

#. type: Plain text
#: en/minios-kernel.1:68
msgid "Package a kernel from a repository or one or more local .deb files."
msgstr ""
"Paketiert einen Kernel aus einem Repository oder aus einer oder mehreren "
"lokalen .deb-Dateien."

#. type: TP
#: en/minios-kernel.1:68 en/minios-kernel.1:190
#, no-wrap
msgid "B<status>"
msgstr "B<status>"

#. type: Plain text
#: en/minios-kernel.1:71
msgid "Check MiniOS directory status and write permissions."
msgstr "Überprüft den Status und die Schreibrechte des MiniOS-Verzeichnisses."

#. type: TP
#: en/minios-kernel.1:71
#, no-wrap
msgid "B<delete>I< kernel-version>"
msgstr "B<delete>I< kernel-version>"

#. type: Plain text
#: en/minios-kernel.1:74
msgid "Delete the specified packaged kernel from the repository."
msgstr "Löschen Sie den angegebenen paketierten Kernel aus dem Repository."

#. type: SH
#: en/minios-kernel.1:74
#, no-wrap
msgid "PACKAGE OPTIONS"
msgstr "PAKETOPTIONEN"

#. type: TP
#: en/minios-kernel.1:75
#, no-wrap
msgid "B<--repo>I< package-name>"
msgstr "B<--repo>I< package-name>"

#. type: Plain text
#: en/minios-kernel.1:79
msgid ""
"Download and package a real versioned kernel package from the existing "
"system APT configuration. Tracking metapackages such as linux-image-amd64 "
"are rejected."
msgstr ""
"Laden und paketieren Sie ein echtes Kernel-Paket mit Versionsnummer aus der "
"bestehenden System-APT-Konfiguration. Metapakete wie linux-image-amd64 "
"werden abgelehnt."

#. type: TP
#: en/minios-kernel.1:79
#, no-wrap
msgid "B<--deb>I< deb-file...>"
msgstr "B<--deb>I< deb-file...>"

#. type: Plain text
#: en/minios-kernel.1:84
msgid ""
"Package a kernel from one or more local .deb files. Debian split kernels "
"require a coherent image, binary, base, and modules set; Ubuntu split "
"kernels require the matching image and modules packages, plus modules-extra "
"when selected."
msgstr ""
"Paketieren Sie einen Kernel aus einer oder mehreren lokalen .deb-Dateien. "
"Debian-gesplittete Kernel erfordern ein konsistentes Set aus image, binary, "
"base und modules; Ubuntu-gesplittete Kernel benötigen die passenden image- "
"und modules-Pakete sowie modules-extra, falls ausgewählt."

#. type: TP
#: en/minios-kernel.1:84
#, no-wrap
msgid "B<-o, --output >I<output-dir>"
msgstr "B<-o, --output >I<output-dir>"

#. type: Plain text
#: en/minios-kernel.1:87
msgid "Directory to save packaged kernel files. Required."
msgstr ""
"Verzeichnis zum Speichern der paketierten Kernel-Dateien. Erforderlich."

#. type: TP
#: en/minios-kernel.1:87
#, no-wrap
msgid "B<--sqfs-comp>I< method>"
msgstr "B<--sqfs-comp>I< method>"

#. type: Plain text
#: en/minios-kernel.1:90
msgid "Compression method for SquashFS image. Default: B<zstd>."
msgstr "Komprimierungsmethode für SquashFS-Abbild. Standard: B<zstd>."

#. type: TP
#: en/minios-kernel.1:90
#, no-wrap
msgid "B<--temp-dir>I< directory>"
msgstr "B<--temp-dir>I< directory>"

#. type: Plain text
#: en/minios-kernel.1:93
msgid "Custom temporary directory (must have at least 1024MB free space)."
msgstr ""
"Benutzerdefiniertes temporäres Verzeichnis (muss mindestens 1024MB freien "
"Speicherplatz haben)."

#. type: TP
#: en/minios-kernel.1:93
#, no-wrap
msgid "B<--force-update>"
msgstr "B<--force-update>"

#. type: Plain text
#: en/minios-kernel.1:97
msgid ""
"Run apt update before repository packaging. Without this option, the "
"existing system package lists are used without an age gate."
msgstr ""
"Führen Sie vor dem Verpacken des Repositorys ein apt update aus. Ohne diese "
"Option werden die vorhandenen System-Paketlisten ohne Altersprüfung "
"verwendet."

#. type: TP
#: en/minios-kernel.1:97
#, no-wrap
msgid "B<--dkms-driver>I< driver-id>"
msgstr "B<--dkms-driver>I< driver-id>"

#. type: Plain text
#: en/minios-kernel.1:102
msgid ""
"Build one additional driver from the curated 01-kernel DKMS catalog. This "
"option may be repeated and is supported only with --repo, where matching "
"headers can be resolved automatically."
msgstr ""
"Bauen Sie einen zusätzlichen Treiber aus dem kuratierten 01-kernel-DKMS-"
"Katalog. Diese Option kann mehrfach angegeben werden und wird nur mit --repo "
"unterstützt, wobei passende Header automatisch aufgelöst werden können."

#. type: SH
#: en/minios-kernel.1:102
#, no-wrap
msgid "PACKAGING"
msgstr "PAKETIERUNG"

#. type: Plain text
#: en/minios-kernel.1:108
msgid ""
"Repository mode resolves matching linux-modules packages automatically. "
"Local mode accepts multiple packages for split kernels. The output includes "
"the kernel image, initramfs, and SquashFS module; selected dpkg metadata is "
"retained inside the SquashFS at I</usr/share/minios/kernel-dpkg/>."
msgstr ""
"Im Repository-Modus werden passende linux-modules-Pakete automatisch "
"aufgelöst. Im lokalen Modus können mehrere Pakete für gesplittete Kernel "
"angegeben werden. Die Ausgabe enthält das Kernel-Image, das initramfs und "
"das SquashFS-Modul; ausgewählte dpkg-Metadaten werden innerhalb der SquashFS "
"unter I</usr/share/minios/kernel-dpkg/> beibehalten."

#. type: Plain text
#: en/minios-kernel.1:113
msgid ""
"Selected DKMS drivers are built in a private overlay chroot without changing "
"the running system package database. Resulting modules are checked against "
"the target kernel version before they are included. Driver provenance is "
"stored at I</usr/share/minios/kernel-dkms/>."
msgstr ""
"Ausgewählte DKMS-Treiber werden in einem privaten Overlay-Chroot gebaut, "
"ohne die laufende System-Paketdatenbank zu verändern. Die resultierenden "
"Module werden vor der Aufnahme auf die Ziel-Kernel-Version geprüft. Die "
"Herkunft der Treiber wird unter I</usr/share/minios/kernel-dkms/> "
"gespeichert."

#. type: Plain text
#: en/minios-kernel.1:118
msgid ""
"Repository downloads are temporary workspace inputs and are removed after "
"success or handled failure. Local input archives remain caller-owned. New "
"bundles use canonical frozen format 1 with a manual held image package, "
"automatic subordinate kernel packages, and no embedded repository "
"configuration."
msgstr ""
"Repository-Downloads sind temporäre Arbeitsbereichseingaben und werden nach "
"Erfolg oder behandeltetem Fehler entfernt. Lokale Eingabearchive verbleiben "
"im Besitz des Aufrufers. Neue Bundles verwenden das kanonische eingefrorene "
"Format 1 mit einem manuell gehaltenen Image-Paket, automatischen "
"untergeordneten Kernel-Paketen und keiner eingebetteten Repository-"
"Konfiguration."

#. type: Plain text
#: en/minios-kernel.1:123
msgid ""
"The canonical runtime module path is /lib/modules/E<lt>versionE<gt>. The "
"physical path stored in the bundle follows the running base system: lib/"
"modules on traditional layouts or usr/lib/modules when /lib is usrmerged. "
"Packaging refuses an existing same-version module tree rather than mix it "
"with a different package revision."
msgstr ""
"Der kanonische Pfad für Laufzeitmodule ist /lib/modules/E<lt>versionE<gt>. "
"Der physische Pfad im Bundle folgt dem laufenden Basissystem: lib/modules "
"bei traditionellen Layouts oder usr/lib/modules, wenn /lib nach usr gemerged "
"ist. Die Paketierung verweigert einen bereits existierenden Modulbaum "
"derselben Version, anstatt ihn mit einer anderen Paketrevision zu vermischen."

#. type: Plain text
#: en/minios-kernel.1:127
msgid ""
"When a writable MiniOS root is detected and the output is not already the "
"repository directory, the completed package is staged atomically into "
"I<E<lt>MiniOS-rootE<gt>/kernels/E<lt>versionE<gt>>."
msgstr ""
"Wird ein beschreibbarer MiniOS-Root erkannt und ist die Ausgabe nicht "
"bereits das Repository-Verzeichnis, wird das fertige Paket atomar nach "
"I<E<lt>MiniOS-rootE<gt>/kernels/E<lt>versionE<gt>> verschoben."

#. type: Plain text
#: en/minios-kernel.1:131
msgid ""
"Packaging requires a MiniOS live runtime with mkdracut or mkinitrfs under I</"
"run/initramfs>, plus mksquashfs, depmod, and dpkg-deb. Repository mode also "
"requires APT."
msgstr ""
"Für die Paketierung ist eine MiniOS-Live-Laufzeit mit mkdracut oder "
"mkinitrfs unter I</run/initramfs> sowie mksquashfs, depmod und dpkg-deb "
"erforderlich. Der Repository-Modus benötigt zusätzlich APT."

#. type: SH
#: en/minios-kernel.1:131
#, no-wrap
msgid "ENCRYPTED PERSISTENCE"
msgstr "VERSCHLÜSSELTE PERSISTENZ"

#. type: Plain text
#: en/minios-kernel.1:136
msgid ""
"When the running initrd advertises encrypted persistence, the replacement "
"kernel must provide dm-crypt support. The generated initramfs is checked for "
"cryptsetup, dm-crypt.ko, and etc/minios-initramfs-crypt. Packaging fails "
"when those safeguards cannot be preserved."
msgstr ""
"Wenn das laufende initrd verschlüsselte Persistenz unterstützt, muss der "
"Ersatzkernel dm-crypt-Unterstützung bereitstellen. Das erzeugte initramfs "
"wird auf cryptsetup, dm-crypt.ko und etc/minios-initramfs-crypt geprüft. Die "
"Paketierung schlägt fehl, wenn diese Schutzmechanismen nicht erhalten "
"bleiben können."

#. type: SH
#: en/minios-kernel.1:136
#, no-wrap
msgid "ACTIVATION"
msgstr "AKTIVIERUNG"

#. type: Plain text
#: en/minios-kernel.1:142
msgid ""
"Activation requires a complete repository entry containing the SquashFS, "
"kernel image, and initramfs. Boot files and bootloader configuration are "
"updated atomically and restored if activation fails. GRUB configuration is "
"required; SYSLINUX configuration is updated when present. Activation affects "
"the next boot and does not reboot the machine."
msgstr ""
"Für die Aktivierung ist ein vollständiger Repository-Eintrag mit SquashFS, "
"Kernel-Image und initramfs erforderlich. Boot-Dateien und Bootloader-"
"Konfiguration werden atomar aktualisiert und bei Fehlschlag der Aktivierung "
"zurückgesetzt. Eine GRUB-Konfiguration ist erforderlich; SYSLINUX-"
"Konfiguration wird aktualisiert, falls vorhanden. Die Aktivierung betrifft "
"den nächsten Bootvorgang und startet das System nicht neu."

#. type: Plain text
#: en/minios-kernel.1:146
msgid ""
"Activation accepts Manager-produced frozen format-1 bundles and canonical "
"tracked bundles produced by 01-kernel. The legacy 1.2.1 metadata shape is "
"accepted only by the live activation compatibility path."
msgstr ""
"Die Aktivierung akzeptiert von Manager erzeugte eingefrorene Format-1-"
"Bundles und kanonisch verfolgte Bundles von 01-kernel. Die Legacy-"
"Metadatenstruktur 1.2.1 wird nur vom Live-Aktivierungskompatibilitätspfad "
"akzeptiert."

#. type: SH
#: en/minios-kernel.1:146
#, no-wrap
msgid "EXAMPLES"
msgstr "BEISPIELE"

#. type: Plain text
#: en/minios-kernel.1:148
msgid "List available kernels:"
msgstr "Verfügbare Kernel auflisten:"

#. type: Plain text
#: en/minios-kernel.1:150
msgid "B<sudo minios-kernel list>"
msgstr "B<sudo minios-kernel list>"

#. type: Plain text
#: en/minios-kernel.1:153
msgid "Activate a specific kernel:"
msgstr "Einen bestimmten Kernel aktivieren:"

#. type: Plain text
#: en/minios-kernel.1:155
msgid "B<sudo minios-kernel activate 6.12.38+deb13-amd64>"
msgstr "B<sudo minios-kernel activate 6.12.38+deb13-amd64>"

#. type: Plain text
#: en/minios-kernel.1:158
msgid "Package kernel from repository:"
msgstr "Kernel aus Repository paketieren:"

#. type: Plain text
#: en/minios-kernel.1:160
msgid ""
"B<sudo minios-kernel package --repo linux-image-6.12.38+deb13-amd64 -o /tmp/"
"output>"
msgstr ""
"B<sudo minios-kernel package --repo linux-image-6.12.38+deb13-amd64 -o /tmp/"
"output>"

#. type: Plain text
#: en/minios-kernel.1:163
msgid "Package a repository kernel with two additional drivers:"
msgstr "Repository-Kernel mit zwei zusätzlichen Treibern paketieren:"

#. type: Plain text
#: en/minios-kernel.1:165
msgid ""
"B<sudo minios-kernel package --repo linux-image-6.12.38+deb13-amd64 --dkms-"
"driver dynblk --dkms-driver rtl8821au -o /tmp/output>"
msgstr ""
"B<sudo minios-kernel package --repo linux-image-6.12.38+deb13-amd64 --dkms-"
"driver dynblk --dkms-driver rtl8821au -o /tmp/output>"

#. type: Plain text
#: en/minios-kernel.1:168
msgid "Package kernel from local .deb file:"
msgstr "Kernel aus lokaler .deb-Datei paketieren:"

#. type: Plain text
#: en/minios-kernel.1:170
msgid "B<sudo minios-kernel package --deb kernel.deb -o /tmp/output>"
msgstr "B<sudo minios-kernel package --deb kernel.deb -o /tmp/output>"

#. type: Plain text
#: en/minios-kernel.1:173
msgid "Delete a packaged kernel:"
msgstr "Paketierten Kernel löschen:"

#. type: Plain text
#: en/minios-kernel.1:175
msgid "B<sudo minios-kernel delete 6.12.38+deb13-amd64>"
msgstr "B<sudo minios-kernel delete 6.12.38+deb13-amd64>"

#. type: SH
#: en/minios-kernel.1:176
#, no-wrap
msgid "JSON OUTPUT"
msgstr "JSON-AUSGABE"

#. type: Plain text
#: en/minios-kernel.1:178
msgid "When using the B<--json> option, commands return structured data:"
msgstr ""
"Bei Verwendung der Option B<--json> geben die Befehle strukturierte Daten "
"zurück:"

#. type: Plain text
#: en/minios-kernel.1:181
msgid "Returns array of kernels with version, status, and metadata."
msgstr "Gibt ein Array von Kerneln mit Version, Status und Metadaten zurück."

#. type: TP
#: en/minios-kernel.1:181
#, no-wrap
msgid "B<activate>"
msgstr "B<aktivieren>"

#. type: Plain text
#: en/minios-kernel.1:184
msgid "Returns success status and activation details."
msgstr "Gibt den Erfolgsstatus und Details zur Aktivierung zurück."

#. type: TP
#: en/minios-kernel.1:184
#, no-wrap
msgid "B<info>"
msgstr "B<info>"

#. type: Plain text
#: en/minios-kernel.1:187
msgid "Returns kernel information including version, status, and system paths."
msgstr ""
"Gibt Kernel-Informationen einschließlich Version, Status und Systempfaden "
"zurück."

#. type: Plain text
#: en/minios-kernel.1:190
msgid "Returns progress updates during packaging and final success status."
msgstr ""
"Gibt Fortschrittsmeldungen während der Paketierung und abschließenden "
"Erfolgsstatus zurück."

#. type: Plain text
#: en/minios-kernel.1:193
msgid "Returns MiniOS directory status and filesystem information."
msgstr ""
"Gibt den Status des MiniOS-Verzeichnisses und Informationen zum Dateisystem "
"zurück."

#. type: TP
#: en/minios-kernel.1:193
#, no-wrap
msgid "B<delete>"
msgstr "B<löschen>"

#. type: Plain text
#: en/minios-kernel.1:196
msgid "Returns success status and deletion details."
msgstr "Gibt den Erfolgsstatus und Details zur Löschung zurück."

#. type: TP
#: en/minios-kernel.1:197
#, no-wrap
msgid "I</run/initramfs/memory/data/minios/>"
msgstr "I</run/initramfs/memory/data/minios/>"

#. type: Plain text
#: en/minios-kernel.1:200
msgid "Preferred MiniOS root in the standard runtime."
msgstr "Bevorzugtes MiniOS-Root im Standard-Laufzeitsystem."

#. type: TP
#: en/minios-kernel.1:200
#, no-wrap
msgid "I</lib/live/mount/medium/minios/>"
msgstr "I</lib/live/mount/medium/minios/>"

#. type: Plain text
#: en/minios-kernel.1:203
msgid "Fallback MiniOS root on a mounted live medium."
msgstr "Alternatives MiniOS-Root auf einem eingebundenen Live-Medium."

#. type: TP
#: en/minios-kernel.1:206
#, no-wrap
msgid "I<E<lt>MiniOS-rootE<gt>/boot/vmlinuz-*>"
msgstr "I<E<lt>MiniOS-rootE<gt>/boot/vmlinuz-*>"

